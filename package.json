{
  "name": "chatwrap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chatwrap — 100% client-side chat analytics",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js tests e2e scripts",
    "test:e2e": "playwright test",
